<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="breaking_games.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="4249"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="meta_ad_sets" custom_title="0" dock_id="1" table="4,12:mainmeta_ad_sets"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011e00ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="Top 10 Products by Revenue*">SELECT product_title, net_items_sold, net_sales, taxes, total_sales
FROM shopify_sales
ORDER BY net_sales DESC
LIMIT 10;</sql><sql name="Count Shopify Sales*">SELECT COUNT(*) FROM shopify_sales     </sql><sql name="Count Shopify Orders*">SELECT COUNT(*) FROM shopify_orders</sql><sql name="Count Shopify Checkouts*">SELECT COUNT(*) FROM shopify_checkouts</sql><sql name="Count Referrals*">SELECT COUNT(*) FROM referrals</sql><sql name="Count Meta Campaigns*">SELECT COUNT(*) FROM meta_campaigns</sql><sql name="Count Meta Ad Sets*">SELECT COUNT(*) FROM meta_ad_sets</sql><sql name="Shopify Sales*">SELECT * FROM shopify_sales;</sql><sql name="Columns in Shopify Sales*">SELECT product_title, total_sales
FROM shopify_sales;</sql><sql name="Units Moved in Shopify Sales*">SELECT product_title, net_items_sold
FROM shopify_sales;</sql><sql name="50 Unit Filter*">SELECT product_title, total_sales
FROM shopify_sales
WHERE net_items_sold &gt; 50;</sql><sql name="100 Unit Filter*">SELECT product_title, total_sales
FROM shopify_sales
WHERE net_items_sold &gt; 100;</sql><sql name="Sorted Revenue*">SELECT product_title, total_sales
FROM shopify_sales
WHERE net_items_sold &gt; 50
ORDER BY total_sales DESC;</sql><sql name="Sort by Units*">SELECT product_title, net_items_sold
FROM shopify_sales
WHERE net_items_sold &gt; 50
ORDER BY net_items_sold DESC;</sql><sql name="Mike's Top 10 Reorder List*">SELECT product_title, total_sales
FROM shopify_sales
WHERE net_items_sold &gt; 50
ORDER BY total_sales DESC
LIMIT 10;</sql><sql name="Group Revenue by Category*">SELECT product_type, COUNT(*) AS n_products, ROUND(SUM(total_sales), 2) AS revenue
FROM shopify_sales
GROUP BY product_type
ORDER BY revenue DESC;</sql><sql name="Fix*">UPDATE shopify_sales
SET product_type = 'Game'
WHERE product_type = 'game';</sql><sql name="Count from NULL Meta Campaigns*">SELECT COUNT(*) FROM meta_campaigns WHERE results IS NULL;</sql><sql name="Counting True Zeros*">SELECT COUNT(*) FROM meta_campaigns WHERE results = 0;</sql><sql name="Average - Skipping Blanks*">SELECT AVG(results) FROM meta_campaigns;</sql><sql name="Average - Blanks as 0*">SELECT AVG(COALESCE(results, 0)) FROM meta_campaigns;</sql><sql name="Sum Both Ways*">SELECT SUM(results), SUM(COALESCE(results, 0)) FROM meta_campaigns;</sql><sql name="Top 10 Products by Units Sold*">SELECT product_title, net_items_sold
FROM shopify_sales
ORDER BY net_items_sold DESC
LIMIT 10;</sql><sql name="Top 10 Products by Total Revenue*">SELECT product_title, total_sales
FROM shopify_sales
ORDER BY total_sales DESC
LIMIT 10;</sql><sql name="Products in the Catalog*">SELECT COUNT(*) FROM shopify_sales;</sql><sql name="Total Meta Ad Spend*">SELECT SUM(spend_usd) FROM meta_campaigns;</sql><sql name="Unique Checkout Sessions Started*">SELECT COUNT(DISTINCT name) FROM shopify_checkouts;</sql><sql name="Walls*">-- How referrals names Dwellings pages
SELECT landing_page, SUM(pageviews) AS views
FROM referrals
WHERE landing_page LIKE '%eldervale%'
GROUP BY landing_page
ORDER BY views DESC;

-- How checkouts names the same products
SELECT DISTINCT lineitem_name
FROM shopify_checkouts
WHERE lineitem_name LIKE '%eldervale%';</sql><sql name="The Facebook Ad*">SELECT campaign_name, spend_usd, link_clicks
FROM meta_campaigns
ORDER BY spend_usd DESC
LIMIT 5;</sql><sql name="The Visit*">SELECT referrer, pageviews, conversion_rate
FROM referrals
WHERE landing_page = '/products/dwellings-of-eldervale-standard-edition-element'
ORDER BY pageviews DESC;</sql><sql name="The Cart*">SELECT name, email, lineitem_name, created_at
FROM shopify_checkouts
WHERE lineitem_name = 'Dwellings of Eldervale 2nd Edition: Standard';</sql><sql name="The Order*">SELECT day, order_name, product_title, total_sales
FROM shopify_orders
WHERE product_title = 'Dwellings of Eldervale 2nd Edition: Standard';</sql><sql name="Create Dimension Table*">DROP TABLE IF EXISTS dim_product;

CREATE TABLE dim_product (
    product_id INTEGER PRIMARY KEY AUTOINCREMENT,
    product_title TEXT NOT NULL,
    product_slug TEXT,
    category TEXT
);</sql><sql name="Fill the Table*">INSERT INTO dim_product (product_title)
SELECT DISTINCT product_title FROM shopify_sales;

SELECT COUNT(*) FROM dim_product;</sql><sql name="Add the Slugs*">UPDATE dim_product
SET product_slug = LOWER(
    REPLACE(REPLACE(REPLACE(product_title, ' ', '-'), ':', ''), '*', '')
);

SELECT product_id, product_title, product_slug FROM dim_product LIMIT 10;</sql><sql name="Link Sales*">ALTER TABLE shopify_sales ADD COLUMN product_id INTEGER;

UPDATE shopify_sales
SET product_id = (
    SELECT product_id FROM dim_product
    WHERE dim_product.product_title = shopify_sales.product_title
);

SELECT COUNT(*) FROM shopify_sales WHERE product_id IS NULL;</sql><sql name="Run the JOIN*">SELECT ss.product_id, dp.product_title, ss.net_items_sold, ss.total_sales
FROM shopify_sales ss
INNER JOIN dim_product dp ON ss.product_id = dp.product_id
ORDER BY ss.total_sales DESC
LIMIT 5;</sql><sql name="Products with Sales but Mysterious Origins*">SELECT dp.product_id, dp.product_title, dp.product_slug, ss.net_items_sold, ss.total_sales
FROM dim_product dp
INNER JOIN shopify_sales ss ON dp.product_id = ss.product_id
LEFT JOIN referrals r ON r.landing_page LIKE '%' || dp.product_slug || '%'
WHERE r.landing_page IS NULL
ORDER BY ss.total_sales DESC;</sql><sql name="Products with Traffic but No Sales*">SELECT r.landing_page,
       SUM(r.pageviews) AS total_pageviews,
       SUM(r.checkout_sessions) AS checkout_sessions
FROM referrals r
LEFT JOIN dim_product dp ON r.landing_page LIKE '%' || dp.product_slug || '%'
WHERE r.landing_page LIKE '/products/%'
  AND dp.product_id IS NULL
GROUP BY r.landing_page
ORDER BY total_pageviews DESC
LIMIT 15;</sql><sql name="The Full Story*">SELECT dp.product_title,
       ss.total_sales,
       ss.net_items_sold,
       COALESCE(pv.total_pageviews, 0) AS total_pageviews,
       ROUND(CAST(pv.total_pageviews AS REAL) / NULLIF(ss.net_items_sold, 0), 1) AS pageviews_per_unit
FROM dim_product dp
INNER JOIN shopify_sales ss ON dp.product_id = ss.product_id
LEFT JOIN (
    SELECT dp2.product_id, SUM(r.pageviews) AS total_pageviews
    FROM dim_product dp2
    INNER JOIN referrals r ON r.landing_page LIKE '%' || dp2.product_slug || '%'
    GROUP BY dp2.product_id
) pv ON pv.product_id = dp.product_id
ORDER BY ss.total_sales DESC;</sql><sql name="Product Performance Leaderboard*">SELECT
    RANK() OVER (ORDER BY SUM(total_sales) DESC) AS revenue_rank,
    product_title,
    SUM(net_items_sold) AS net_items_sold,
    ROUND(SUM(total_sales), 2) AS total_sales,
    ROUND(SUM(total_sales) / NULLIF(SUM(net_items_sold), 0), 2) AS aov
FROM shopify_sales
GROUP BY product_title
HAVING SUM(net_items_sold) &gt; 0
ORDER BY total_sales DESC
LIMIT 25;</sql><sql name="Hand-count Small Subset*">SELECT product_title, total_sales
FROM shopify_sales
ORDER BY total_sales DESC
LIMIT 5;</sql><sql name="Cross-check with Different Aggregation Path*">SELECT SUM(net_sales) + SUM(taxes) AS rebuilt_total
FROM shopify_sales;
-- should land on the same total Claude reported</sql><sql name="Building the Table*">DROP TABLE IF EXISTS fact_product_performance;

CREATE TABLE fact_product_performance AS
SELECT
    dp.product_id,
    dp.product_title,
    COALESCE(ss.total_sales, 0)    AS total_sales,
    COALESCE(ss.net_items_sold, 0) AS units_sold,
    ROUND(ss.total_sales / NULLIF(ss.net_items_sold, 0), 2) AS aov,
    ROUND(100.0 * ss.total_sales / (SELECT SUM(total_sales) FROM shopify_sales), 2) AS pct_of_revenue,
    COALESCE((
        SELECT SUM(r.pageviews) FROM referrals r
        WHERE r.landing_page = '/products/' || dp.product_slug
    ), 0) AS total_pageviews,
    COALESCE((
        SELECT SUM(r.pageviews) FROM referrals r
        WHERE r.landing_page = '/products/' || dp.product_slug
          AND r.referrer IN ('facebook', 'instagram')
    ), 0) AS meta_pageviews,
    CASE WHEN EXISTS (
        SELECT 1 FROM referrals r
        WHERE r.landing_page = '/products/' || dp.product_slug
    ) THEN 1 ELSE 0 END AS traffic_matched
FROM dim_product dp
LEFT JOIN shopify_sales ss ON ss.product_id = dp.product_id;</sql><sql name="Table Check*">SELECT COUNT(*) FROM fact_product_performance;   -- expected: 116
SELECT * FROM fact_product_performance ORDER BY total_sales DESC LIMIT 3;</sql><sql name="Alter Table Name*">ALTER TABLE fact_product_performance RENAME COLUMN units_sold TO net_items_sold;</sql><sql name="Print Heavy*">SELECT product_title, total_sales, net_items_sold, aov, total_pageviews
FROM fact_product_performance
WHERE total_sales &gt; 0
ORDER BY total_sales DESC
LIMIT 10;</sql><sql name="Print Light*">SELECT product_title, total_sales, net_items_sold, aov, total_pageviews
FROM fact_product_performance
WHERE total_sales &gt; 0
ORDER BY total_sales DESC
LIMIT 5 OFFSET 10;</sql><sql name="Don't Print*">SELECT product_title, total_sales, net_items_sold, total_pageviews
FROM fact_product_performance
ORDER BY total_sales ASC
LIMIT 10;</sql><sql name="Top Traffic Sources*">SELECT 
    COALESCE(NULLIF(referrer, ''), 'direct') AS referrer,
    SUM(pageviews) AS pageviews
FROM referrals
GROUP BY referrer
ORDER BY pageviews DESC
LIMIT 15;</sql><sql name="Data Pageviews*">SELECT 
    COALESCE(NULLIF(referrer, ''), 'direct') AS referrer,
    SUM(pageviews) AS pageviews
FROM referrals
GROUP BY referrer
ORDER BY pageviews DESC
LIMIT 50;</sql><sql name="Build dim_referrer with Taxonomy*">DROP TABLE IF EXISTS dim_referrer;

CREATE TABLE dim_referrer (
    referrer TEXT PRIMARY KEY,
    channel TEXT,
    channel_type TEXT
);

INSERT INTO dim_referrer (referrer)
SELECT DISTINCT COALESCE(NULLIF(referrer, ''), 'direct') FROM referrals;

-- 1. Direct
UPDATE dim_referrer SET channel = 'Direct', channel_type = 'Owned'
WHERE referrer = 'direct';

-- 2. Paid Social (Meta)
UPDATE dim_referrer SET channel = 'Paid Social (Meta)', channel_type = 'Paid'
WHERE referrer IN ('facebook', 'instagram', 'meta', 'internalfb');

-- 3. Paid Display
UPDATE dim_referrer SET channel = 'Paid Display', channel_type = 'Paid'
WHERE referrer IN ('googlesyndication');

-- 4. Organic Search
UPDATE dim_referrer SET channel = 'Organic Search', channel_type = 'Organic'
WHERE referrer IN ('google', 'bing', 'duckduckgo', 'brave', 'yahoo!', 'yandex',
                   'ecosia', 'syndicatedsearch', 'qwant', 'baidu', 'yahoo! images');

-- 5. Email &amp; Owned Sites
UPDATE dim_referrer SET channel = 'Email &amp; Owned Sites', channel_type = 'Owned'
WHERE referrer IN ('gmail', 'klaviyo', 'mailchi', 'yahoo! mail', 'aol mail', 'deref-mail',
                   'seznam mail', 'naver mail', 'qq mail',
                   'dwellingsofeldervaleshop', 'poopthegame', 'mixtapethegame', 'mensamindgames');

-- 6. Community &amp; Social
UPDATE dim_referrer SET channel = 'Community &amp; Social', channel_type = 'Organic'
WHERE referrer IN ('boardgamegeek', 'boardgamearena', 'boardlife', 'reddit', 'tabletopbellhop',
                   'boardgameoracle', 'cardboardedison', 'spritesanddice',
                   'youtube', 'tiktok', 'pinterest', 'twitter', 'linkedin', 'linktr',
                   'gencon', 'mapyourshow', 'kickstarter');

-- 7. Bot / Suspicious
UPDATE dim_referrer SET channel = 'Bot / Suspicious', channel_type = 'Exclude'
WHERE referrer IN ('admagic', 'trafficheap', 'shopifybooster', 'robots', 'sheet2site-staging');

-- Catch-all (always last)
UPDATE dim_referrer SET channel = 'Other', channel_type = 'Other'
WHERE channel IS NULL;</sql><sql name="Verify Channels*">   SELECT dr.channel, dr.channel_type, SUM(r.pageviews) AS pageviews
   FROM referrals r
   JOIN dim_referrer dr
     ON dr.referrer = COALESCE(NULLIF(r.referrer, ''), 'direct')
   GROUP BY dr.channel, dr.channel_type
   ORDER BY pageviews DESC;</sql><sql name="Paid Social (Meta)*">WITH fb_spend AS (
    SELECT ROUND(SUM(spend_usd), 2) AS total_spend
    FROM meta_campaigns
    WHERE delivery_status IN ('active', 'inactive')
),
fb_traffic AS (
    SELECT SUM(r.pageviews) AS pageviews,
           SUM(r.checkout_sessions) AS checkouts
    FROM referrals r
    JOIN dim_referrer dr ON COALESCE(NULLIF(r.referrer, ''), 'direct') = dr.referrer
    WHERE dr.channel = 'Paid Social (Meta)'
)
SELECT fs.total_spend, ft.pageviews, ft.checkouts,
       ROUND(fs.total_spend / NULLIF(ft.pageviews, 0), 4) AS cost_per_pageview,
       ROUND(fs.total_spend / NULLIF(ft.checkouts, 0), 2) AS cost_per_checkout_session
FROM fb_spend fs, fb_traffic ft;</sql><sql name="Facebook Traffic Landing*">SELECT 
    dp.product_title,
    COALESCE(SUM(CASE WHEN dr.channel = 'Paid Social (Meta)' THEN r.pageviews END), 0) AS fb_pageviews,
    COALESCE(ss.net_items_sold, 0) AS units_sold,
    COALESCE(ROUND(ss.total_sales, 2), 0) AS revenue
FROM dim_product dp
LEFT JOIN referrals r ON r.landing_page LIKE '%' || dp.product_slug || '%'
LEFT JOIN dim_referrer dr ON COALESCE(NULLIF(r.referrer, ''), 'direct') = dr.referrer
LEFT JOIN shopify_sales ss ON ss.product_id = dp.product_id
GROUP BY dp.product_id, dp.product_title, ss.net_items_sold, ss.total_sales
HAVING fb_pageviews &gt; 100
ORDER BY fb_pageviews DESC
LIMIT 15;</sql><sql name="Channel Table*">WITH channel_traffic AS (
    SELECT dr.channel,
           SUM(r.pageviews) AS pageviews,
           SUM(r.checkout_sessions) AS checkouts
    FROM referrals r
    JOIN dim_referrer dr ON COALESCE(NULLIF(r.referrer, ''), 'direct') = dr.referrer
    GROUP BY dr.channel
),
meta_spend AS (
    SELECT SUM(spend_usd) AS spend FROM meta_campaigns
)
SELECT ct.channel,
       ct.pageviews,
       ct.checkouts,
       ROUND(100.0 * ct.checkouts / NULLIF(ct.pageviews, 0), 2) AS conversion_rate_pct,
       CASE WHEN ct.channel = 'Paid Social (Meta)' THEN ROUND(ms.spend, 2) END AS spend,
       CASE WHEN ct.channel = 'Paid Social (Meta)' THEN ROUND(ms.spend / NULLIF(ct.pageviews, 0), 2) END AS cost_per_pageview,
       CASE WHEN ct.channel = 'Paid Social (Meta)' THEN ROUND(ms.spend / NULLIF(ct.checkouts, 0), 2) END AS cost_per_checkout_session
FROM channel_traffic ct
CROSS JOIN meta_spend ms
ORDER BY ct.pageviews DESC;</sql><sql name="CTR &amp; CPC*">SELECT 
    campaign_name,
    spend_usd,
    impressions,
    link_clicks,
    ROUND(ctr_link, 3) AS ctr_pct,
    ROUND(cpc_usd, 2) AS cpc_usd
FROM meta_campaigns
WHERE link_clicks &gt; 0
ORDER BY ctr_link DESC
LIMIT 10;</sql><sql name="Most Efficient*">SELECT 
    campaign_name,
    delivery_status,
    spend_usd,
    results,
    ROUND(cost_per_result, 2) AS cost_per_result_usd
FROM meta_campaigns
WHERE results IS NOT NULL AND results &gt; 0
  AND delivery_status IN ('active', 'inactive')
ORDER BY cost_per_result ASC
LIMIT 10;</sql><sql name="Highest CTR*">SELECT 
    campaign_name,
    impressions,
    link_clicks,
    ROUND(ctr_link, 3) AS ctr_pct,
    spend_usd
FROM meta_campaigns
WHERE impressions &gt; 1000   -- exclude noise from low-volume campaigns
  AND ctr_link IS NOT NULL
ORDER BY ctr_link DESC
LIMIT 10;</sql><sql name="Highest Volume*">SELECT 
    campaign_name,
    spend_usd,
    results,
    result_indicator,
    ROUND(cost_per_result, 2) AS cost_per_result_usd
FROM meta_campaigns
WHERE results IS NOT NULL AND results &gt; 0
ORDER BY results DESC
LIMIT 10;</sql><sql name="The Bottom*">SELECT 
    campaign_name,
    delivery_status,
    spend_usd,
    impressions,
    link_clicks,
    results,
    ROUND(cost_per_result, 2) AS cost_per_result_usd
FROM meta_campaigns
WHERE spend_usd &gt; 100   -- ignore campaigns that barely ran
  AND (
       (results IS NULL OR results = 0)            -- no conversions
    OR (cost_per_result &gt; 100)                     -- absurdly expensive
    OR (ctr_link &lt; 0.1 AND impressions &gt; 10000)    -- weak CTR at scale
  )
ORDER BY spend_usd DESC;</sql><sql name="Result Indicator*">SELECT 
    result_indicator,
    COUNT(*) AS n_campaigns,
    ROUND(SUM(spend_usd), 2) AS total_spend,
    ROUND(AVG(cost_per_result), 2) AS avg_cost_per_result
FROM meta_campaigns
GROUP BY result_indicator;</sql><sql name="Keep Running*">SELECT 
    campaign_name,
    delivery_status,
    spend_usd,
    results,
    result_indicator,
    ROUND(cost_per_result, 2) AS cost_per_result_usd
FROM meta_campaigns
WHERE results IS NOT NULL AND results &gt; 0
ORDER BY cost_per_result ASC
LIMIT 10;</sql><sql name="High Volume Workhorses*">SELECT 
    campaign_name,
    spend_usd,
    results,
    ROUND(cost_per_result, 2) AS cost_per_result_usd
FROM meta_campaigns
WHERE results IS NOT NULL AND results &gt; 0
ORDER BY results DESC
LIMIT 10;</sql><sql name="Cut Pile*">SELECT 
    campaign_name,
    delivery_status,
    spend_usd,
    impressions,
    link_clicks,
    results,
    ROUND(cost_per_result, 2) AS cost_per_result_usd
FROM meta_campaigns
WHERE spend_usd &gt; 100   -- ignore campaigns that barely ran
  AND (
       (results IS NULL OR results = 0)            -- no conversions
    OR (cost_per_result &gt; 100)                     -- absurdly expensive
    OR (ctr_link &lt; 0.1 AND impressions &gt; 10000)    -- weak CTR at scale
  )
ORDER BY spend_usd DESC;</sql><sql name="SQL 70"></sql><current_tab id="64"/></tab_sql></sqlb_project>
